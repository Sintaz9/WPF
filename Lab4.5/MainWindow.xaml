<Window x:Class="Lab4._5.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Lab4._5.Converters"
        Title="Магазин кофе и чая" 
        Height="600" Width="1000"
        MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:RatingToStarsConverter x:Key="RatingToStarsConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:DiscountToVisibilityConverter x:Key="DiscountToVisibilityConverter"/>
        <converters:CategoryIdToNameConverter x:Key="CategoryIdToNameConverter"/>
        <converters:StockToColorConverter x:Key="StockToColorConverter"/>
        <converters:StockToTextConverter x:Key="StockToTextConverter"/>
        <converters:PriceToStringConverter x:Key="PriceToStringConverter"/>

        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Margin="0,0,0,10">
            <MenuItem Header="Файл">
                <MenuItem Header="Загрузить данные" Command="{Binding LoadDataCommand}"/>
                <MenuItem Header="Сохранить" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Товары">
                <MenuItem Header="Добавить товар" Command="{Binding AddProductCommand}"/>
                <MenuItem Header="Редактировать" Command="{Binding EditProductCommand}"/>
                <MenuItem Header="Удалить" Command="{Binding DeleteProductCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Панель управления -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Обновить" Command="{Binding LoadDataCommand}" 
                        Width="80" Margin="0,0,5,0"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                        Width="80"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="Роль: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding CurrentRole}" VerticalAlignment="Center" 
                           FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="{Binding RoleButtonText}" Command="{Binding ToggleRoleCommand}" 
                        Width="180"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="300" Margin="0,0,5,0"/>
                <Button Content="Поиск" Command="{Binding SearchCommand}" Width="80"/>
            </StackPanel>
        </DockPanel>

        <!-- Панель фильтров -->
        <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="5" 
                Padding="10" Margin="0,0,0,10">
            <WrapPanel>
                <TextBlock Text="Фильтр по категории:" VerticalAlignment="Center" 
                           Margin="0,0,10,0" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name"
                          Width="200" Margin="0,0,10,0"/>
                <Button Content="Применить" Command="{Binding FilterByCategoryCommand}" 
                        Width="80" Margin="0,0,5,0"/>
                <Button Content="Сбросить" Command="{Binding ClearFilterCommand}" 
                        Width="80"/>
            </WrapPanel>
        </Border>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding Products}" 
                     SelectedItem="{Binding SelectedProduct}"
                     Background="Transparent" BorderBrush="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProductCardStyle}" Width="280">
                            <StackPanel>
                                <!-- Название -->
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" 
                                           TextWrapping="Wrap" Margin="0,0,0,5"/>

                                <!-- Категория -->
                                <TextBlock Text="{Binding CategoryId, Converter={StaticResource CategoryIdToNameConverter}}" 
                                           FontSize="12" Foreground="#666" Margin="0,0,0,5"/>

                                <!-- Рейтинг -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToStarsConverter}}" 
                                               FontSize="16" Foreground="#FFD700"/>
                                    <TextBlock Text="{Binding Rating, StringFormat=' {0:F1}'}" 
                                               FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>

                                <!-- Описание -->
                                <TextBlock Text="{Binding Description}" FontSize="12" 
                                           TextWrapping="Wrap" Height="40" Margin="0,0,0,10"
                                           Foreground="#555"/>

                                <!-- Цена -->
                                <StackPanel Margin="0,0,0,5">
                                    <TextBlock Text="{Binding FinalPrice, Converter={StaticResource PriceToStringConverter}}" 
                                               FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                                    <TextBlock Text="{Binding Price, Converter={StaticResource PriceToStringConverter}}" 
                                               FontSize="12" Foreground="Gray"
                                               Visibility="{Binding Discount, Converter={StaticResource DiscountToVisibilityConverter}}"
                                               TextDecorations="Strikethrough"/>
                                </StackPanel>

                                <!-- Наличие -->
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,5,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding InStock, Converter={StaticResource StockToColorConverter}}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock FontSize="12">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource StockToTextConverter}">
                                                <Binding Path="InStock"/>
                                                <Binding Path="Quantity"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Строка состояния -->
        <StatusBar Grid.Row="4" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Products.Count, StringFormat='Товаров: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>