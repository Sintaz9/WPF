<Window x:Class="Lab4._5.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Lab4._5.Converters"
        xmlns:controls="clr-namespace:Lab4._5.Controls"
        xmlns:cmd="clr-namespace:Lab4._5.Commands"
        Title="Магазин кофе и чая" 
        Height="600" Width="1200"
        MinHeight="400" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Cursor="/Resources/cursor.cur"
        Background="{DynamicResource BackgroundColor}"
        Icon="/Resources/icon.ico">

    <Window.CommandBindings>
        <CommandBinding Command="cmd:CustomCommands.BuyProduct"
                        Executed="BuyProduct_Executed"
                        CanExecute="BuyProduct_CanExecute"/>
    </Window.CommandBindings>

    <Window.Resources>
        <converters:RatingToStarsConverter x:Key="RatingToStarsConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:DiscountToVisibilityConverter x:Key="DiscountToVisibilityConverter"/>
        <converters:CategoryIdToNameConverter x:Key="CategoryIdToNameConverter"/>
        <converters:StockToColorConverter x:Key="StockToColorConverter"/>
        <converters:StockToTextConverter x:Key="StockToTextConverter"/>
        <converters:PriceToStringConverter x:Key="PriceToStringConverter"/>

        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="CircleBorder"
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="20"
                                    Width="40" Height="40"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Button.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.15" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.15" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <MenuItem Header="{DynamicResource MenuFile}">
                <MenuItem Header="{DynamicResource MenuLoad}" Command="{Binding LoadDataCommand}"/>
                <MenuItem Header="{DynamicResource MenuSave}" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource MenuExit}" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuProducts}">
                <MenuItem Header="{DynamicResource MenuAddProduct}" Command="{Binding AddProductCommand}"/>
                <MenuItem Header="{DynamicResource MenuEditProduct}" Command="{Binding EditProductCommand}"/>
                <MenuItem Header="{DynamicResource MenuDeleteProduct}" Command="{Binding DeleteProductCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Account}" Command="{Binding OpenAccountCommand}"/>
            <MenuItem Header="{DynamicResource Undo}" Command="{Binding UndoCommand}"/>
            <MenuItem Header="{DynamicResource Redo}" Command="{Binding RedoCommand}"/>
        </Menu>

        <!-- Панель управления -->
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <Button Content="{DynamicResource BtnRefresh}" Command="{Binding LoadDataCommand}"/>
                    <Button Content="{DynamicResource BtnSave}" Command="{Binding SaveCommand}" />
                </StackPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <Button Content="RU" Command="{Binding SwitchLanguageCommand}" CommandParameter="ru-RU"/>
                    <Button Content="EN" Command="{Binding SwitchLanguageCommand}" CommandParameter="en-US" />
                </StackPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="☀" ToolTip="Светло-зелёная" Command="{Binding SwitchThemeCommand}" CommandParameter="LightGreenTheme" Margin="0,2,2,0"/>
                        <Button Content="🌙" ToolTip="Тёмная" Command="{Binding SwitchThemeCommand}" CommandParameter="DarkGreenTheme" Margin="0,2,2,0"/>
                        <Button Content="💧" ToolTip="Голубая" Command="{Binding SwitchThemeCommand}" CommandParameter="BlueTheme" Margin="0,2,2,0"/>
                    </StackPanel>
                    <Button Content="👑 Админ-панель" ToolTip="Управление БД (CRUD, SQL сортировка, топ товаров)" Command="{Binding OpenAdminWindowCommand}" Background="DarkSlateBlue" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="{DynamicResource LabelRole}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding CurrentRole}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <controls:ToggleSwitch x:Name="RoleToggle" Width="90" Height="35"
                                       IsChecked="{Binding IsAdminMode}"
                                       OnText="ADMIN" OffText="USER"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,5,0"/>
                    <Button Content="{DynamicResource BtnSearch}" Command="{Binding SearchCommand}" Width="80"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{DynamicResource SortByName}" Command="{Binding SortCommand}" CommandParameter="name"/>
                    <Button Content="{DynamicResource SortByPrice}" Command="{Binding SortCommand}" CommandParameter="price"/>
                    <Button Content="{DynamicResource SortByRating}" Command="{Binding SortCommand}" CommandParameter="rating"/>
                    <Button Content="{DynamicResource SortReset}" Command="{Binding SortCommand}" CommandParameter="reset"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Фильтры -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                Background="{DynamicResource SurfaceColor}" CornerRadius="8" 
                Padding="15" Margin="0,0,0,10" 
                BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                    <TextBlock Text="{DynamicResource FilterCategory}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                    <TextBlock Text="{DynamicResource FilterPriceFrom}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                    <TextBox Text="{Binding PriceFromText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                    <TextBlock Text="{DynamicResource FilterPriceTo}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                    <TextBox Text="{Binding PriceToText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                    <TextBlock Text="{DynamicResource FilterStock}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                    <ComboBox SelectedIndex="{Binding InStockFilterIndex}" Width="120">
                        <ComboBoxItem Content="{DynamicResource FilterAll}"/>
                        <ComboBoxItem Content="{DynamicResource FilterInStock}"/>
                        <ComboBoxItem Content="{DynamicResource FilterOutOfStock}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                    <TextBlock Text="{DynamicResource FilterRating}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                    <TextBox Text="{Binding RatingFilterText, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                </StackPanel>
                <Button Content="{DynamicResource BtnApply}" Command="{Binding ApplyFiltersCommand}" Margin="0,0,5,0"/>
                <Button Content="{DynamicResource BtnReset}" Command="{Binding ClearFilterCommand}"/>
            </WrapPanel>
        </Border>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="3" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                     Background="Transparent" BorderBrush="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" Width="280" Margin="5" Padding="10"
                                CornerRadius="8" BorderThickness="2"
                                Background="{DynamicResource SurfaceColor}"
                                BorderBrush="{DynamicResource SurfaceBorderColor}">
                            <StackPanel>
                                <Border Height="150" Margin="0,0,0,10" 
                                        Background="{DynamicResource BackgroundColor}" CornerRadius="5">
                                    <Image Source="{Binding FirstImagePath}" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CategoryId, Converter={StaticResource CategoryIdToNameConverter}}" 
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <controls:RatingControl Value="{Binding Rating}" IsReadOnly="True"/>
                                    <TextBlock Text="{Binding Rating, StringFormat={} {0:F1}}" FontSize="12" 
                                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" 
                                           Height="40" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryColor}"/>
                                <StackPanel Margin="0,0,0,5">
                                    <TextBlock Text="{Binding FinalPrice, Converter={StaticResource PriceToStringConverter}}" 
                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Text="{Binding Price, Converter={StaticResource PriceToStringConverter}}" 
                                               FontSize="12" Foreground="Gray" TextDecorations="Strikethrough"
                                               Visibility="{Binding Discount, Converter={StaticResource DiscountToVisibilityConverter}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="10" Height="10" Margin="0,0,5,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding InStock, Converter={StaticResource StockToColorConverter}}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock FontSize="12">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource StockToTextConverter}">
                                                <Binding Path="InStock"/>
                                                <Binding Path="Quantity"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
                                    <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <controls:NumericUpDown Width="120" Height="35"
                                                            MinValue="1" MaxValue="{Binding Quantity}"
                                                            Value="{Binding BuyCount, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                    <Button Content="📄" ToolTip="{DynamicResource BtnDetails}"
                                            Background="{DynamicResource DangerColor}" Style="{StaticResource RoundButtonStyle}"
                                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" Margin="0,0,10,0"/>
                                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE719;" ToolTip="{DynamicResource Buy}"
                                            Background="{DynamicResource AccentColor}" Style="{StaticResource RoundButtonStyle}"
                                            Command="cmd:CustomCommands.BuyProduct" CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.IsAdminMode, 
                                            Converter={StaticResource BooleanToVisibilityConverter}, 
                                            ConverterParameter=invert,
                                            RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Quantity}" Value="0">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="Red"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InStock}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="Gold"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="3"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding InStock}" Value="True"/>
                                    <Condition Binding="{Binding Rating}" Value="4"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="LimeGreen"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="4"/>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Статус бар -->
        <StatusBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}: {1}">
                            <Binding Path="ProductsCountText"/>
                            <Binding Path="Products.Count"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>