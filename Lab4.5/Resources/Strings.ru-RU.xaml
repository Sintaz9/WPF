    <system:String x:Key="Buy">Купить</system:String>
    <system:String x:Key="BuySuccess">Товар куплен:</system:String>
    <system:String x:Key="BuyOutOfStock">Товар закончился!</system:String>
    <system:String x:Key="BuyError">Ошибка</system:String>
