    <system:String x:Key="ErrorPriceRequired">Цена обязательна</system:String>
    <system:String x:Key="ErrorPriceInvalid">Введите корректную цену</system:String>
    <system:String x:Key="ErrorDiscountInvalid">Скидка должна быть от 0 до 100</system:String>
    <system:String x:Key="ErrorQuantityRequired">Количество обязательно</system:String>
