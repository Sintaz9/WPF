<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Для лабы 8 (ADO.NET) -->
    <add name="CoffeeShopDb" 
         connectionString="Data Source=CoffeeShop.db"
         providerName="System.Data.Sqlite" />
    <!-- Для лабы 9 (Entity Framework) -->
    <add name="CoffeeShopEF" 
         connectionString="Data Source=CoffeeShop_EF.db"
         providerName="Microsoft.Data.Sqlite" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>