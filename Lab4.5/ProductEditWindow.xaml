<Window x:Class="Lab4._5.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Lab4._5.Converters"
        Title="Редактирование товара" 
        Height="700" Width="600"
        MinHeight="600" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ErrorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,15"/>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Краткое название -->
                <TextBlock Text="Краткое название *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>
                <TextBlock Text="{Binding NameError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasNameError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Полное название -->
                <TextBlock Text="Полное название *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>
                <TextBlock Text="{Binding FullNameError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasFullNameError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Категория -->
                <TextBlock Text="Категория *" Style="{StaticResource FormLabelStyle}"/>
                <ComboBox ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name"
                          Height="25"/>

                <!-- Цена -->
                <TextBlock Text="Цена (₽) *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>
                <TextBlock Text="{Binding PriceError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasPriceError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Скидка -->
                <TextBlock Text="Скидка (%)" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>
                <TextBlock Text="{Binding DiscountError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasDiscountError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Количество -->
                <TextBlock Text="Количество на складе *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>
                <TextBlock Text="{Binding QuantityError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasQuantityError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Страна -->
                <TextBlock Text="Страна происхождения" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- Цвет -->
                <TextBlock Text="Цвет упаковки" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- Размер -->
                <TextBlock Text="Размер/Вес" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- Производитель -->
                <TextBlock Text="Производитель" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- Описание -->
                <TextBlock Text="Описание *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                <TextBlock Text="{Binding DescriptionError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasDescriptionError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Рейтинг -->
                <TextBlock Text="Рейтинг (0-5)" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding RatingText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FormTextBoxStyle}"/>
                <TextBlock Text="{Binding RatingError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasRatingError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Изображения -->
                <TextBlock Text="Изображения товара" Style="{StaticResource FormLabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Content="Добавить изображение" Click="AddImage_Click" 
                            Width="150" Height="25" Margin="0,0,10,0"/>
                    <Button Content="Удалить выбранное" Click="RemoveImage_Click" 
                            Width="150" Height="25"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding ImagePaths}" 
                         SelectedItem="{Binding SelectedImagePath}"
                         Height="80" Margin="0,5,0,10"
                         BorderBrush="#E0E0E0" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" Margin="2" 
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Предпросмотр -->
                <Image x:Name="PreviewImage" 
                       Height="150" Margin="0,0,0,10"
                       Stretch="Uniform"
                       Visibility="Collapsed"/>

                <TextBlock Text="* - обязательные поля" FontSize="11" Foreground="#666" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Height="30" Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" Height="30" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>