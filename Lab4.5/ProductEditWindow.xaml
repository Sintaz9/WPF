<Window x:Class="Lab4._5.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Lab4._5.Converters"
        Title="{DynamicResource EditTitle}" 
        Height="700" Width="600"
        MinHeight="600" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Cursor="/Resources/cursor.cur"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundColor}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style x:Key="ErrorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Название -->
                <TextBlock Text="{DynamicResource Name}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>
                <TextBlock Text="{Binding NameError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasNameError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Полное название -->
                <TextBlock Text="{DynamicResource FullName}"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>
                <TextBlock Text="{Binding FullNameError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasFullNameError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Категория -->
                <TextBlock Text="{DynamicResource CategoryLabel}"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" Height="25"/>

                <!-- Цена -->
                <TextBlock Text="{DynamicResource PriceLabel}"/>
                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>
                <TextBlock Text="{Binding PriceError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasPriceError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Скидка -->
                <TextBlock Text="{DynamicResource Discount}"/>
                <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>
                <TextBlock Text="{Binding DiscountError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasDiscountError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Количество -->
                <TextBlock Text="{DynamicResource QuantityLabel}"/>
                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>
                <TextBlock Text="{Binding QuantityError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasQuantityError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Страна -->
                <TextBlock Text="{DynamicResource CountryLabel}"/>
                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>

                <!-- Цвет -->
                <TextBlock Text="{DynamicResource ColorLabel}"/>
                <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>

                <!-- Размер -->
                <TextBlock Text="{DynamicResource SizeLabel}"/>
                <TextBox Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>

                <!-- Производитель -->
                <TextBlock Text="{DynamicResource ManufacturerLabel}"/>
                <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>

                <!-- Описание -->
                <TextBlock Text="{DynamicResource DescriptionLabel}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                <!-- Рейтинг -->
                <TextBlock Text="{DynamicResource RatingLabel}"/>
                <TextBox Text="{Binding RatingText, UpdateSourceTrigger=PropertyChanged}" 
                         Height="25" VerticalContentAlignment="Center"/>
                <TextBlock Text="{Binding RatingError}" Style="{StaticResource ErrorStyle}" 
                           Visibility="{Binding HasRatingError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Изображения -->
                <TextBlock Text="{DynamicResource ImagesLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Content="{DynamicResource BtnAddImage}" Click="AddImage_Click" 
                            Width="150" Height="25" Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource BtnRemoveImage}" Click="RemoveImage_Click" 
                            Width="150" Height="25"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding ImagePaths}" SelectedItem="{Binding SelectedImagePath}"
                         Height="80" Margin="0,5,0,10"
                         BorderBrush="{DynamicResource SurfaceBorderColor}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" Margin="2" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Image x:Name="PreviewImage" Height="150" Margin="0,0,0,10" Stretch="Uniform" Visibility="Collapsed"/>

                <TextBlock Text="{DynamicResource RequiredFields}" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource BtnSave}" Width="100" Height="30" Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            <Button Content="{DynamicResource BtnClose}" Width="100" Height="30" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>