<UserControl x:Class="Lab4._5.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32"
             Width="140">

    <UserControl.Resources>
        <!-- Стиль для кнопок-стрелок -->
        <Style x:Key="ArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#CCCCCC" 
            BorderThickness="1" 
            CornerRadius="4" 
            Background="White">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Поле ввода числа -->
            <TextBox x:Name="ValueTextBox" 
                     Grid.Column="0"
                     Text="{Binding Value, 
                                    RelativeSource={RelativeSource AncestorType=UserControl}, 
                                    UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     FontSize="14"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="8,0"
                     CaretBrush="#555555"
                     TextAlignment="Center"/>

            <!-- Разделитель -->
            <Border Grid.Column="1" 
                    Width="1" 
                    Background="#CCCCCC" 
                    Margin="0,4"/>

            <!-- Контейнер вертикальных кнопок -->
            <StackPanel Grid.Column="2" 
                        Orientation="Vertical"
                        Width="28">

                <!-- Кнопка увеличения -->
                <Button x:Name="UpButton" 
                        Content="▲" 
                        Click="UpButton_Click"
                        Style="{StaticResource ArrowButtonStyle}"
                        Height="15.5"
                        BorderThickness="0,0,0,0.5"
                        BorderBrush="#CCCCCC"
                        Padding="0"/>

                <!-- Кнопка уменьшения -->
                <Button x:Name="DownButton" 
                        Content="▼" 
                        Click="DownButton_Click"
                        Style="{StaticResource ArrowButtonStyle}"
                        Height="15.5"
                        BorderThickness="0"
                        Padding="0"/>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>