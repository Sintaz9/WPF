<UserControl x:Class="Lab4._5.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="60" Height="30"
             Cursor="Hand">

    <UserControl.Resources>
        <!-- Анимация для переключателя -->
        <Storyboard x:Key="SlideOn">
            <ThicknessAnimation Storyboard.TargetName="Thumb"
                               Storyboard.TargetProperty="Margin"
                               To="30,2,2,2" Duration="0:0:0.15"/>
        </Storyboard>
        <Storyboard x:Key="SlideOff">
            <ThicknessAnimation Storyboard.TargetName="Thumb"
                               Storyboard.TargetProperty="Margin"
                               To="2,2,30,2" Duration="0:0:0.15"/>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="SwitchBorder" 
            CornerRadius="15" 
            BorderThickness="1"
            MouseLeftButtonDown="SwitchBorder_MouseLeftButtonDown">
        <Border.Background>
            <SolidColorBrush x:Name="BackgroundBrush" Color="LightGray"/>
        </Border.Background>

        <Grid>
            <!-- Ползунок -->
            <Border x:Name="Thumb" 
                    Width="26" Height="26"
                    CornerRadius="13"
                    Margin="2,2,30,2"
                    HorizontalAlignment="Left"
                    Background="White">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" Opacity="0.3"/>
                </Border.Effect>
            </Border>

            <!-- Текст ON/OFF -->
            <TextBlock x:Name="StateText" 
                       Text="OFF"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0"/>
        </Grid>
    </Border>
</UserControl>