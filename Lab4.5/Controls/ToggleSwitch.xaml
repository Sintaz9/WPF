<UserControl x:Class="Lab4._5.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="60" Height="30"
             Cursor="Hand">

    <Border x:Name="SwitchBorder" 
            CornerRadius="15" 
            BorderThickness="1"
            Background="LightGray"
            MouseLeftButtonDown="SwitchBorder_MouseLeftButtonDown">

        <Grid>
            <!-- Ползунок -->
            <Border x:Name="Thumb" 
                    Width="26" Height="26"
                    CornerRadius="13"
                    VerticalAlignment="Center"
                    Background="White">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" Opacity="0.3"/>
                </Border.Effect>
            </Border>

            <!-- Текст ON/OFF -->
            <TextBlock x:Name="StateText" 
                       Text="OFF"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>