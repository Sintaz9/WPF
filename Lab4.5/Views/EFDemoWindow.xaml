<Window x:Class="Lab4._5.Views.EFDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📊 Entity Framework Demo - Лаба 9" 
        Height="550" Width="850"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Демонстрация Entity Framework (Code First + Database First)"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"
                   Foreground="Green"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="➕ Добавить товар" Command="{Binding AddCommand}" 
                    Background="Green" Foreground="White" Margin="0,0,5,0" Padding="10,5"/>
            <Button Content="✏️ Редактировать" Command="{Binding EditCommand}" 
                    Background="Orange" Foreground="White" Margin="0,0,5,0" Padding="10,5"/>
            <Button Content="🗑️ Удалить" Command="{Binding DeleteCommand}" 
                    Background="Red" Foreground="White" Margin="0,0,15,0" Padding="10,5"/>
            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" 
                    Margin="0,0,5,0" Padding="10,5"/>
        </WrapPanel>

        <Border Grid.Row="2" Background="#EEEEEE" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Width="180" Margin="0,0,15,0"/>

                    <TextBlock Text="📁 Категория:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name" Width="120" Margin="0,0,15,0"/>

                    <Button Content="🔍 Применить (LINQ)" Command="{Binding ApplyFiltersCommand}" 
                            Margin="0,0,5,0" Padding="10,5"/>
                    <Button Content="❌ Сбросить" Command="{Binding ClearFiltersCommand}" 
                            Padding="10,5"/>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="📊 Сортировка (LINQ):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="150" SelectedItem="{Binding SelectedSort}" Margin="0,0,15,0">
                        <ComboBoxItem Content="По имени ↑"/>
                        <ComboBoxItem Content="По имени ↓"/>
                        <ComboBoxItem Content="По цене ↑"/>
                        <ComboBoxItem Content="По цене ↓"/>
                        <ComboBoxItem Content="По рейтингу ↑"/>
                        <ComboBoxItem Content="По рейтингу ↓"/>
                    </ComboBox>
                    <Button Content="📊 Применить сортировку" Command="{Binding ApplySortCommand}" 
                            Padding="10,5"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding Products}" 
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  Margin="0,0,0,10"
                  AlternatingRowBackground="#F5F5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200" IsReadOnly="False"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100" IsReadOnly="False"/>
                <DataGridTextColumn Header="Скидка %" Binding="{Binding Discount}" Width="80" IsReadOnly="False"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80" IsReadOnly="False"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="80" IsReadOnly="False"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Entity Framework Core | Code First | Database First"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>