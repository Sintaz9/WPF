<Window x:Class="Lab4._5.Views.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Account}" 
        Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundColor}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Account}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource Username}" FontWeight="Bold" Margin="0,5,0,2"/>
                <TextBlock Text="{Binding Username}" Margin="0,0,0,10" FontSize="14"/>

                <TextBlock Text="Роль" FontWeight="Bold" Margin="0,5,0,2"/>
                <TextBlock Text="{Binding Role}" Margin="0,0,0,10" FontSize="14"/>

                <TextBlock Text="Имя" FontWeight="Bold" Margin="0,5,0,2"/>
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,10"
                         Background="{DynamicResource SurfaceColor}" Foreground="{DynamicResource TextColor}" 
                         BorderBrush="{DynamicResource SurfaceBorderColor}" CaretBrush="{DynamicResource TextColor}"/>

                <TextBlock Text="{DynamicResource Email}" FontWeight="Bold" Margin="0,5,0,2"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,10"
                         Background="{DynamicResource SurfaceColor}" Foreground="{DynamicResource TextColor}" 
                         BorderBrush="{DynamicResource SurfaceBorderColor}" CaretBrush="{DynamicResource TextColor}"/>

                <TextBlock Text="{DynamicResource About}" FontWeight="Bold" Margin="0,5,0,2"/>
                <TextBox Text="{Binding About, UpdateSourceTrigger=PropertyChanged}" Height="60" Margin="0,0,0,10"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Background="{DynamicResource SurfaceColor}" Foreground="{DynamicResource TextColor}" 
                         BorderBrush="{DynamicResource SurfaceBorderColor}" CaretBrush="{DynamicResource TextColor}"/>

                <Separator Margin="0,10"/>

                <TextBlock Text="{DynamicResource Language}" FontWeight="Bold" Margin="0,5,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="RU" Command="{Binding SwitchLanguageCommand}" CommandParameter="ru-RU" 
                            Width="40" Margin="0,0,5,0"/>
                    <Button Content="EN" Command="{Binding SwitchLanguageCommand}" CommandParameter="en-US" 
                            Width="40"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource Theme}" FontWeight="Bold" Margin="0,5,0,2"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="☀" ToolTip="Светло-зелёная" Command="{Binding SwitchThemeCommand}" 
                            CommandParameter="LightGreenTheme" Width="40" Margin="0,0,5,0"/>
                    <Button Content="🌙" ToolTip="Тёмная" Command="{Binding SwitchThemeCommand}" 
                            CommandParameter="DarkGreenTheme" Width="40" Margin="0,0,5,0"/>
                    <Button Content="💧" ToolTip="Голубая" Command="{Binding SwitchThemeCommand}" 
                            CommandParameter="BlueTheme" Width="40"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource BtnSave}" Width="100" Height="30" Margin="0,0,10,0"
            Click="SaveButton_Click"/>
            <Button Content="{DynamicResource BtnClose}" Width="100" Height="30" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>