<Window x:Class="Lab4._5.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👑 Панель администратора - управление БД" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Управление товарами (База данных SQLite)" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"
                   Foreground="{DynamicResource AccentColor}"/>

        <!-- Панель кнопок CRUD -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="➕ Добавить" Command="{Binding AddProductCommand}" 
                    Background="Green" Foreground="White" Margin="0,0,5,0" Padding="10,5"/>
            <Button Content="✏️ Редактировать" Command="{Binding EditProductCommand}" 
                    Background="Orange" Foreground="White" Margin="0,0,5,0" Padding="10,5"/>
            <Button Content="🗑️ Удалить" Command="{Binding DeleteProductCommand}" 
                    Background="Red" Foreground="White" Margin="0,0,15,0" Padding="10,5"/>

            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" 
                    Margin="0,0,5,0" Padding="10,5"/>
            <Button Content="💾 Синхр. с JSON" Command="{Binding SyncFromJsonCommand}" 
                    Margin="0,0,5,0" Padding="10,5" ToolTip="Импорт товаров из JSON файла"/>
            <Button Content="🏆 Топ товаров" Command="{Binding ShowTopProductsCommand}" 
                    Margin="0,0,5,0" Padding="10,5" ToolTip="Хранимая процедура"/>
        </WrapPanel>

        <!-- Панель фильтрации и сортировки -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceColor}" CornerRadius="8" 
                Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Width="200" Margin="0,0,15,0"/>

                    <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name" Width="150" Margin="0,0,15,0"/>

                    <TextBlock Text="Цена от:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding PriceFromText}" Width="70" Margin="0,0,5,0"/>

                    <TextBlock Text="до:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding PriceToText}" Width="70" Margin="0,0,15,0"/>

                    <Button Content="🔍 Применить" Command="{Binding ApplyFiltersCommand}" 
                            Margin="0,0,5,0" Padding="10,5"/>
                    <Button Content="❌ Сбросить" Command="{Binding ClearFiltersCommand}" 
                            Padding="10,5"/>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton Content="По имени ↑" GroupName="Sort" 
                                 IsChecked="{Binding SortByNameAsc}" Margin="0,0,10,0"/>
                    <RadioButton Content="По имени ↓" GroupName="Sort" 
                                 IsChecked="{Binding SortByNameDesc}" Margin="0,0,15,0"/>
                    <RadioButton Content="По цене ↑" GroupName="Sort" 
                                 IsChecked="{Binding SortByPriceAsc}" Margin="0,0,10,0"/>
                    <RadioButton Content="По цене ↓" GroupName="Sort" 
                                 IsChecked="{Binding SortByPriceDesc}" Margin="0,0,15,0"/>
                    <RadioButton Content="По рейтингу ↑" GroupName="Sort" 
                                 IsChecked="{Binding SortByRatingAsc}" Margin="0,0,10,0"/>
                    <RadioButton Content="По рейтингу ↓" GroupName="Sort" 
                                 IsChecked="{Binding SortByRatingDesc}" Margin="0,0,15,0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- DataGrid для отображения товаров (CRUD) -->
        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding Products}" 
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  IsReadOnly="False"
                  Margin="0,0,0,10"
                  Background="{DynamicResource SurfaceColor}"
                  AlternatingRowBackground="{DynamicResource BackgroundColor}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="180" IsReadOnly="False"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryId}" Width="80" IsReadOnly="False"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=C}" Width="100" IsReadOnly="False"/>
                <DataGridTextColumn Header="Скидка %" Binding="{Binding Discount}" Width="80" IsReadOnly="False"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80" IsReadOnly="False"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="80" IsReadOnly="False"/>
                <DataGridTextColumn Header="Продано" Binding="{Binding SoldCount}" Width="80" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="В наличии" Binding="{Binding InStock}" Width="80"/>
                <DataGridTemplateColumn Header="Действия" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏️" Command="{Binding DataContext.EditProductCommand, 
                                        RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        CommandParameter="{Binding}" Margin="2" Width="30"/>
                                <Button Content="🗑️" Command="{Binding DataContext.DeleteProductCommand, 
                                        RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        CommandParameter="{Binding}" Margin="2" Width="30"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ProductsCount, StringFormat='Всего товаров: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>