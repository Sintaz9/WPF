<Window x:Class="Lab4._5.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Lab4._5.Converters"
        Title="👑 Панель администратора - управление БД" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}">

    <Grid Margin="10">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки навигации -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки CRUD -->
            <RowDefinition Height="Auto"/>
            <!-- Фильтры -->
            <RowDefinition Height="*"/>
            <!-- DataGrid (главное место) -->
            <RowDefinition Height="Auto"/>
            <!-- Статус бар -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀ Назад" 
            Click="BackButton_Click" 
            Padding="10,5" 
            Margin="0,0,15,0"
            ToolTip="Вернуться в главное окно"/>
            
            <!-- Заголовок -->
            <TextBlock Grid.Column="1" Text="Панель администратора" 
               FontSize="20" FontWeight="Bold"
               HorizontalAlignment="Center"
               Foreground="{DynamicResource AccentColor}"/>
        </Grid>
        <!-- КНОПКИ НАВИГАЦИИ МЕЖДУ ТАБЛИЦАМИ -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <RadioButton x:Name="rbProducts" Content="📦 Товары" GroupName="TableNav"
                         IsChecked="{Binding ShowProductsTable}" 
                         Margin="0,0,10,0" FontWeight="Bold" Padding="10,5"/>
            <RadioButton x:Name="rbCategories" Content="🏷️ Категории" GroupName="TableNav"
                         IsChecked="{Binding ShowCategoriesTable}" 
                         Margin="0,0,10,0" FontWeight="Bold" Padding="10,5"/>
            <RadioButton x:Name="rbOrders" Content="🧾 Заказы" GroupName="TableNav"
                         IsChecked="{Binding ShowOrdersTable}" 
                         Margin="0,0,10,0" FontWeight="Bold" Padding="10,5"/>
            <RadioButton x:Name="rbOrderItems" Content="📋 Позиции заказов" GroupName="TableNav"
                         IsChecked="{Binding ShowOrderItemsTable}" 
                         Margin="0,0,10,0" FontWeight="Bold" Padding="10,5"/>
        </WrapPanel>

        <!-- ПАНЕЛЬ CRUD (только для товаров) -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceColor}" CornerRadius="8" 
                Padding="10" Margin="0,0,0,10" Visibility="{Binding ProductsPanelVisible}">
            <WrapPanel>
                <Button Content="➕ Добавить товар" Command="{Binding AddProductCommand}" 
                        Background="Green" Foreground="White" Margin="0,0,5,0" Padding="10,5"/>
                <Button Content="✏️ Редактировать" Command="{Binding EditProductCommand}" 
                        Background="Orange" Foreground="White" Margin="0,0,5,0" Padding="10,5"/>
                <Button Content="🗑️ Удалить" Command="{Binding DeleteProductCommand}" 
                        Background="Red" Foreground="White" Margin="0,0,15,0" Padding="10,5"/>
                <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" 
                        Margin="0,0,5,0" Padding="10,5"/>
                <Button Content="💾 Синхр. с JSON" Command="{Binding SyncFromJsonCommand}" 
                        Margin="0,0,5,0" Padding="10,5" ToolTip="Импорт товаров из JSON файла"/>
                <Button Content="🏆 Топ товаров" Command="{Binding ShowTopProductsCommand}" 
                        Margin="0,0,5,0" Padding="10,5" ToolTip="Хранимая процедура"/>
            </WrapPanel>
        </Border>

        <!-- ПАНЕЛЬ ФИЛЬТРОВ И СОРТИРОВКИ (только для товаров) -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceColor}" CornerRadius="8" 
                Padding="10" Margin="0,0,0,10" Visibility="{Binding ProductsPanelVisible}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Width="200" Margin="0,0,15,0"/>
                    <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name" Width="150" Margin="0,0,15,0"/>
                    <TextBlock Text="Цена от:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding PriceFromText}" Width="70" Margin="0,0,5,0"/>
                    <TextBlock Text="до:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding PriceToText}" Width="70" Margin="0,0,15,0"/>
                    <Button Content="🔍 Применить" Command="{Binding ApplyFiltersCommand}" Margin="0,0,5,0" Padding="10,5"/>
                    <Button Content="❌ Сбросить" Command="{Binding ClearFiltersCommand}" Padding="10,5"/>
                </WrapPanel>
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton Content="По имени ↑" GroupName="Sort" IsChecked="{Binding SortByNameAsc}" Margin="0,0,10,0"/>
                    <RadioButton Content="По имени ↓" GroupName="Sort" IsChecked="{Binding SortByNameDesc}" Margin="0,0,15,0"/>
                    <RadioButton Content="По цене ↑" GroupName="Sort" IsChecked="{Binding SortByPriceAsc}" Margin="0,0,10,0"/>
                    <RadioButton Content="По цене ↓" GroupName="Sort" IsChecked="{Binding SortByPriceDesc}" Margin="0,0,15,0"/>
                    <RadioButton Content="По рейтингу ↑" GroupName="Sort" IsChecked="{Binding SortByRatingAsc}" Margin="0,0,10,0"/>
                    <RadioButton Content="По рейтингу ↓" GroupName="Sort" IsChecked="{Binding SortByRatingDesc}" Margin="0,0,15,0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ТАБЛИЦА ТОВАРОВ -->
        <DataGrid Grid.Row="4" 
                  ItemsSource="{Binding Products}" 
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  IsReadOnly="False"
                  Margin="0,0,0,10"
                  Background="{DynamicResource SurfaceColor}"
                  AlternatingRowBackground="{DynamicResource BackgroundColor}"
                  Visibility="{Binding ProductsTableVisible}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="180" IsReadOnly="False"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=C}" Width="100" IsReadOnly="False"/>
                <DataGridTextColumn Header="Скидка %" Binding="{Binding Discount}" Width="80" IsReadOnly="False"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80" IsReadOnly="False"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="80" IsReadOnly="False"/>
                <DataGridTextColumn Header="Продано" Binding="{Binding SoldCount}" Width="80" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="В наличии" Binding="{Binding InStock}" Width="80"/>
                <DataGridTemplateColumn Header="Действия" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏️" Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        CommandParameter="{Binding}" Margin="2" Width="30"/>
                                <Button Content="🗑️" Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        CommandParameter="{Binding}" Margin="2" Width="30"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ТАБЛИЦА КАТЕГОРИЙ -->
        <DataGrid Grid.Row="4" 
                  ItemsSource="{Binding Categories}" 
                  AutoGenerateColumns="False"
                  Margin="0,0,0,10"
                  Background="{DynamicResource SurfaceColor}"
                  Visibility="{Binding CategoriesTableVisible}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название категории" Binding="{Binding Name}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ТАБЛИЦА ЗАКАЗОВ -->
        <DataGrid Grid.Row="4" 
                  ItemsSource="{Binding Orders}" 
                  SelectedItem="{Binding SelectedOrder}"
                  AutoGenerateColumns="False"
                  Margin="0,0,0,10"
                  Background="{DynamicResource SurfaceColor}"
                  Visibility="{Binding OrdersTableVisible}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="150"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                <DataGridTemplateColumn Header="Детали" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="📋 Позиции" 
                                    Command="{Binding DataContext.ShowOrderItemsCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                    CommandParameter="{Binding}" Padding="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ТАБЛИЦА ПОЗИЦИЙ ЗАКАЗОВ -->
        <DataGrid Grid.Row="4" 
                  ItemsSource="{Binding OrderItems}" 
                  AutoGenerateColumns="False"
                  Margin="0,0,0,10"
                  Background="{DynamicResource SurfaceColor}"
                  Visibility="{Binding OrderItemsTableVisible}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Заказ ID" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="200"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat=C}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding RecordsCount, StringFormat='Записей: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>