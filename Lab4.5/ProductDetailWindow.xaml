<Window x:Class="Lab4._5.Views.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Lab4._5.Converters"
        xmlns:controls="clr-namespace:Lab4._5.Controls"
        Title="{DynamicResource ProductDetails}" 
        Height="600" Width="700"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundColor}">

    <Window.Resources>
        <converters:StockToColorConverter x:Key="StockToColorConverter"/>
        <converters:StockToTextConverter x:Key="StockToTextConverter"/>
        <converters:CategoryIdToNameConverter x:Key="CategoryIdToNameConverter"/>
        <converters:PriceToStringConverter x:Key="PriceToStringConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:DiscountToVisibilityConverter x:Key="DiscountToVisibilityConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SurfaceBorderColor}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SelectedProduct.Name}" 
                               FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedProduct.FullName}" 
                               FontSize="14" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock FontSize="14" HorizontalAlignment="Right"
                               Text="{Binding SelectedProduct.Rating, StringFormat='{}{0:F1}'}"/>
                    <controls:RatingControl Value="{Binding SelectedProduct.Rating, Mode=OneWay}" IsReadOnly="True" 
                         HorizontalAlignment="Right"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Right" Margin="0,5,0,0"
                               Text="{Binding SelectedProduct.SoldCount, StringFormat='Продано: {0}'}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Изображение (BLOB) -->
                <Border Height="200" Margin="0,0,0,15" 
                        Background="{DynamicResource BackgroundColor}" CornerRadius="5">
                    <Image Source="{Binding SelectedProduct.Image, Converter={StaticResource ByteArrayToImageConverter}}" 
                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Основная информация -->
                <TextBlock Text="Основная информация" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Категория" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding SelectedProduct.CategoryId, Converter={StaticResource CategoryIdToNameConverter}}" 
                               TextWrapping="Wrap" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Производитель" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="{Binding SelectedProduct.Manufacturer}" 
                               TextWrapping="Wrap" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Страна" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" 
                               Text="{Binding SelectedProduct.Country}" 
                               TextWrapping="Wrap" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Цвет / Размер" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedProduct.Color}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding SelectedProduct.Size}"/>
                    </StackPanel>
                </Grid>

                <!-- Описание -->
                <TextBlock Text="Описание" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>
                <TextBlock Text="{Binding SelectedProduct.Description}" 
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- Цена и наличие -->
                <TextBlock Text="Цена и наличие" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>

                <Border Background="{DynamicResource BackgroundColor}" Padding="15" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Цена:" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedProduct.FinalPrice, Converter={StaticResource PriceToStringConverter}}" 
                                       FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Text="{Binding SelectedProduct.Price, Converter={StaticResource PriceToStringConverter}}" 
                                       FontSize="16" Foreground="Gray" TextDecorations="Strikethrough" 
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding SelectedProduct.Discount, Converter={StaticResource DiscountToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding SelectedProduct.Discount, StringFormat=' -{0}%'}" 
                                       FontSize="14" Foreground="{DynamicResource DangerColor}" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding SelectedProduct.Discount, Converter={StaticResource DiscountToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Наличие:" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Ellipse Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding SelectedProduct.InStock, Converter={StaticResource StockToColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource StockToTextConverter}">
                                        <Binding Path="SelectedProduct.InStock"/>
                                        <Binding Path="SelectedProduct.Quantity"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Количество:" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedProduct.Quantity}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Дополнительная информация -->
                <TextBlock Text="Дополнительная информация" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ID товара" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding SelectedProduct.Id}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Продано" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding SelectedProduct.SoldCount}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Редактировать" Margin="0,0,10,0" Padding="15,5"
                    Visibility="{Binding IsAdminMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="EditButton_Click"/>
            <Button Content="Удалить" Margin="0,0,10,0" Padding="15,5"
                    Visibility="{Binding IsAdminMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="DeleteButton_Click"/>
            <Button Content="Закрыть" IsCancel="True" Padding="15,5" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>