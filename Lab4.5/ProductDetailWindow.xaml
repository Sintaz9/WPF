<Window x:Class="Lab4._5.Views.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Lab4._5.Converters"
        Title="{DynamicResource ProductDetails}" 
        Height="600" Width="700"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Cursor="/Resources/cursor.cur"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundColor}">

    <Window.Resources>
        <converters:RatingToStarsConverter x:Key="RatingToStarsConverter"/>
        <converters:StockToColorConverter x:Key="StockToColorConverter"/>
        <converters:StockToTextConverter x:Key="StockToTextConverter"/>
        <converters:CategoryIdToNameConverter x:Key="CategoryIdToNameConverter"/>
        <converters:PriceToStringConverter x:Key="PriceToStringConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:DiscountToVisibilityConverter x:Key="DiscountToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SurfaceBorderColor}" BorderThickness="0,0,0,1" 
                Padding="0,0,0,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SelectedProduct.Name}" 
                               FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedProduct.FullName}" 
                               FontSize="14" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock FontSize="14" HorizontalAlignment="Right"
                               Text="{Binding SelectedProduct.Rating, StringFormat='{}{0:F1}'}"/>
                    <TextBlock Text="{Binding SelectedProduct.Rating, Converter={StaticResource RatingToStarsConverter}}" 
                               FontSize="20" Foreground="{DynamicResource StarColor}" HorizontalAlignment="Right"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Right" Margin="0,5,0,0"
                               Text="{Binding SelectedProduct.SoldCount, StringFormat='{}{0}'}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Изображения -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" 
                              Height="200" Margin="0,0,0,15">
                    <ItemsControl ItemsSource="{Binding SelectedProduct.ImagePaths}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" 
                                       Height="200" Width="200" 
                                       Stretch="Uniform" Margin="0,0,10,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Основная информация -->
                <TextBlock Text="{DynamicResource MainInfo}" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Category}" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding SelectedProduct.CategoryId, Converter={StaticResource CategoryIdToNameConverter}}" 
                               TextWrapping="Wrap" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Manufacturer}" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="{Binding SelectedProduct.Manufacturer}" 
                               TextWrapping="Wrap" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Country}" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" 
                               Text="{Binding SelectedProduct.Country}" 
                               TextWrapping="Wrap" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource ColorSize}" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedProduct.Color}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding SelectedProduct.Size}"/>
                    </StackPanel>
                </Grid>

                <!-- Описание -->
                <TextBlock Text="{DynamicResource Description}" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>
                <TextBlock Text="{Binding SelectedProduct.Description}" 
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- Цена и наличие -->
                <TextBlock Text="{DynamicResource PriceAndStock}" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>

                <Border Background="{DynamicResource BackgroundColor}" Padding="15" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Price}" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedProduct.FinalPrice, Converter={StaticResource PriceToStringConverter}}" 
                                       FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Text="{Binding SelectedProduct.Price, Converter={StaticResource PriceToStringConverter}}" 
                                       FontSize="16" Foreground="Gray" TextDecorations="Strikethrough" 
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding SelectedProduct.Discount, Converter={StaticResource DiscountToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding SelectedProduct.Discount, StringFormat=' -{0}%'}" 
                                       FontSize="14" Foreground="{DynamicResource DangerColor}" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding SelectedProduct.Discount, Converter={StaticResource DiscountToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Stock}" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Ellipse Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding SelectedProduct.InStock, Converter={StaticResource StockToColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource StockToTextConverter}">
                                        <Binding Path="SelectedProduct.InStock"/>
                                        <Binding Path="SelectedProduct.Quantity"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Quantity}" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedProduct.Quantity}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Дополнительная информация -->
                <TextBlock Text="{DynamicResource AdditionalInfo}" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource ProductId}" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding SelectedProduct.Id}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SoldCount}" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding SelectedProduct.SoldCount}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource BtnEdit}" Width="100" Height="30" Margin="0,0,10,0"
                    Visibility="{Binding IsAdminMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="EditButton_Click"/>
            <Button Content="{DynamicResource BtnDelete}" Width="100" Height="30" Margin="0,0,10,0"
                    Visibility="{Binding IsAdminMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="DeleteButton_Click"/>
            <Button Content="{DynamicResource BtnClose}" Width="100" Height="30" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>